# ── Server ──────────────────────────────────────
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# ── Database ────────────────────────────────────
# Docker Compose 사용 시 DB_HOST=mysql (컨테이너명)
DB_HOST=mysql
DB_USER=barofarm
DB_PASS=your_strong_db_password
DB_NAME=barofarm

# ── Auth ────────────────────────────────────────
# openssl rand -hex 32 로 생성
JWT_SECRET=your_jwt_secret_here

# ── LiveKit ─────────────────────────────────────
LIVEKIT_KEY=your_livekit_api_key
LIVEKIT_SECRET=your_livekit_api_secret
LIVEKIT_URL=wss://your-project.livekit.cloud

# ── 배송 조회 (Sweet Tracker) ───────────────────
# https://info.sweettracker.co.kr 에서 발급
SWEETTRACKER_API_KEY=

# ── 결제/지갑/경매인증 정책 (config/payment-policy.ts) ──────────────
# 아래 항목은 전부 선택값이며, 미설정 시 코드 기본값(주석에 표기)을 사용한다.
# 하드코딩 금지 원칙에 따라 정책값 추가 시 payment-policy.ts에도 함께 반영할 것.

# 결제 인증세션(payment_auth_sessions) 만료 — 목적(purpose)별 비활동/절대 만료(분 단위)
PAY_AUTH_SESSION_INACTIVITY_MIN=30
PAY_AUTH_SESSION_ABSOLUTE_MIN=120
PAY_AUTH_SESSION_AUCTION_INACTIVITY_MIN=30
PAY_AUTH_SESSION_AUCTION_ABSOLUTE_MIN=120
PAY_AUTH_SESSION_PAYMENT_INACTIVITY_MIN=30
PAY_AUTH_SESSION_PAYMENT_ABSOLUTE_MIN=120

# 결제비밀번호 잠금 정책 — 연속 실패 임계치 / 잠금 지속시간(분)
PAY_LOCKOUT_MAX_FAILED_ATTEMPTS=5
PAY_LOCKOUT_MINUTES=10

# 재인증(승급 인증)이 필요한 기준 금액(원) — 이상이면 고액용 재인증을 요구
PAY_REAUTH_HIGH_VALUE_PAYMENT=1000000
PAY_REAUTH_HIGH_VALUE_BID=10000000

# 결제비밀번호 정책 — 자릿수 / 단순번호(연속·반복·전화번호 뒷자리) 등록 거부 여부
PAY_PASSWORD_DIGIT_LENGTH=6
PAY_PASSWORD_REJECT_SIMPLE=true

# 적립률(bp=1/10000, 200bp=2%) — 바로팜페이(자체 머니) vs 카드/계좌 등 외부결제 요율을 분리 적용
PAY_EARN_RATE_BAROFARM_PAY_BP=200
PAY_EARN_RATE_EXTERNAL_BP=50
# 적립금 원 단위 미만 처리 — FLOOR(절사, 기본) | ROUND(반올림) | CEIL(올림)
PAY_EARN_ROUNDING=FLOOR

# 포인트 사용 우선순위(쉼표 구분, 왼쪽부터 먼저 소진) — 자산유형: EVENT_POINT/TEST_POINT/EARNED_POINT/COMPENSATION_POINT
PAY_POINT_USE_PRIORITY=EVENT_POINT,TEST_POINT,EARNED_POINT,COMPENSATION_POINT

# Feature Flag — 운영 환경에서는 아래 두 값을 반드시 false로 유지할 것(README-payment.md §운영 체크리스트 참고)
PAY_FF_TEST_POINT_ENABLED=false
PAY_FF_DEVELOPER_TOOLS_ENABLED=false
# Mock PG 사용 여부 — 실 PG 연동 전에는 반드시 true(false로 바꾸려면 실제 Provider 구현체가 필요)
PAY_FF_MOCK_PG_ENABLED=true

# 어드민 테스트포인트/테스트머니 지급·회수 — 운영 환경 하드 차단(미설정 시 NODE_ENV=production이면 자동 true)
PAY_TEST_POINT_PRODUCTION_DISABLED=
# PRODUCTION_DISABLED가 true여도 예외적으로 테스트 자산 지급을 허용할 사용자 ID(쉼표 구분, QA 계정 등)
PAY_TEST_POINT_ALLOWED_USER_IDS=

# REST 인증형 입찰(§22) — 경매별 minimum_bid_increment 미설정 시 기본 최소 입찰단위(원)
PAY_BID_DEFAULT_MIN_INCREMENT=1000
